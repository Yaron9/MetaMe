{
    "name": "metame-cli",
    "version": "1.6.4",
    "description": "The cognitive profile and agent runtime layer for Claude Code and Codex.",
    "main": "index.js",
    "bin": {
        "metame": "./index.js"
    },
    "files": [
        "index.js",
        "scripts/",
        "!scripts/**/*.test.js",
        "!scripts/test-support/",
        "!scripts/test_daemon.js",
        "!scripts/sync-readme.js",
        "!scripts/hooks/test-*.js",
        "!scripts/daemon.yaml",
        "!scripts/daemon.yaml.bak",
        "skills/"
    ],
    "scripts": {
        "test": "node --require ./scripts/test-support/env-setup.js --test scripts/*.test.js",
        "test:daemon-status": "node --require ./scripts/test-support/env-setup.js --test scripts/daemon-restart-status.test.js",
        "start": "node index.js",
        "deploy": "node index.js deploy",
        "push": "bash scripts/bin/push-clean.sh",
        "sync:plugin": "node scripts/sync-plugin.js",
        "sync:readme": "node scripts/sync-readme.js",
        "restart:daemon": "node index.js stop 2>/dev/null; sleep 1; node index.js start 2>/dev/null || echo '鈿狅笍  Daemon not running or restart failed'",
        "prepublishOnly": "npm run sync:plugin && node scripts/prepublish-check.js",
        "precommit": "npm run sync:plugin && npm run restart:daemon"
    },
    "keywords": [
        "claude",
        "codex",
        "ai",
        "meta-cognition",
        "productivity",
        "cli"
    ],
    "author": "Yaron",
    "license": "MIT",
    "dependencies": {
        "@larksuiteoapi/node-sdk": "^1.58.0",
        "js-yaml": "^4.1.1"
    },
    "engines": {
        "node": ">=22.5"
    },
    "devDependencies": {
        "qrcode": "^1.5.4"
    }
}
